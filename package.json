{
  "name": "hacktrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "start:all": "node scripts/start-all.mjs",
    "server": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "client:build": "cmake -S hacktrack-client -B hacktrack-client/build -G Ninja && cmake --build hacktrack-client/build",
    "client:demo": "node scripts/run-client.mjs --demo",
    "client:bench": "node scripts/run-client.mjs --bench",
    "client:console": "node scripts/run-client.mjs --console",
    "test": "npm --prefix server test && node scripts/run-client.mjs --tests && node scripts/integration.mjs"
  },
  "dependencies": {
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "description": "HackTrack: Next.js website -> C++17 client (hand-written data structures) -> Node + SQLite server"
}
