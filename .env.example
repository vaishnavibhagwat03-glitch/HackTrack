# Copy this file to .env and fill it in. Never commit .env.

# Password for admin@hacktrack.dev. Used when the database is first created.
# Pick something long; it is the only account that can change the event.
HACKTRACK_ADMIN_PASSWORD=change-me-to-something-long

# Where the site is served:
#   :80                          plain HTTP on the server's IP address (start here)
#   hacktrack.example.com        your domain; Caddy turns on HTTPS automatically
#   203-0-113-7.sslip.io         HTTPS without buying a domain (your IP, dots -> dashes)
SITE_ADDRESS=:80

# Optional: "Sign in with Google". Paste the OAuth client ID from Google Cloud
# (it ends in .apps.googleusercontent.com). Leave empty to hide the Google button.
# After changing it, rebuild: docker compose up -d --build
GOOGLE_CLIENT_ID=
